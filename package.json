    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.111.1",
    "webpack-bundle-analyzer": "5.4.0",
    "webpack-cli": "7.2.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "config": {
    "blanket": {
      "pattern": "src",
      "data-cover-never": [
        "node_modules",
        "tests"
      ],
      "data-cover-reporter-options": {
        "shortnames": true
      }
    }
  },
  "overrides": {
    "serialize-javascript": ">=7.0.4",
    "nodemailer": "$nodemailer",
    "imap": {
      "utf7": {
        "semver": ">=7.0.0"
      }
    },
    "preview-email": {
      "uuid": ">=11.1.0"
    },
    "istanbul-lib-processinfo": {
      "uuid": ">=11.1.0"
    },
    "minimatch": ">=3.1.5",
    "websocket-driver": ">=0.7.5",
    "fast-uri": "3.1.4",
    "linkify-it": "5.0.2",
    "ws": "8.21.1",
    "js-yaml": "4.3.0",
    "grunt": {
      "js-yaml": "3.15.0"
    },
    "nconf-yaml": {
      "js-yaml": "3.15.0"
    },
    "nyc": {
      "@istanbuljs/load-nyc-config": {
        "js-yaml": "3.15.0"
      }
    },
    "undici": "7.28.0",
    "form-data": "4.0.6",
    "brace-expansion": "5.0.8",
    "postcss": "8.5.24",
    "@opentelemetry/core": "2.8.0",
    "email-templates": {
      "juice": {
        "cheerio": {
          "undici": "6.27.0"
        }
      }
    }
  },
  "packageManager": "npm@10.9.9"
