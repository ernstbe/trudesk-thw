{
  "name": "trudesk",
  "version": "1.2.11",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": "./app.js",
  "scripts": {
    "start": "node ./app",
    "build": "grunt build",
    "test": "mocha --recursive",
    "lint": "standard | snazzy",
    "format": "standard --fix \"./*.js\" \"src/*.js\" \"src/**/*.js\" \"src/**/*.jsx\"",
    "coverage": "nyc --reporter=lcovonly npm run test",
    "codacy": "npm run coverage && bash <(curl -Ls https://coverage.codacy.com/get.sh) report -r ./coverage/lcov.info && rm -rf ./coverage",
    "webpackwatch": "webpack --config webpack.config.js --watch",
    "webpackdev": "webpack --config webpack.config.js",
    "webpackdist": "rimraf public/js/* && cross-env NODE_ENV=production webpack --env production --config webpack.config.js"
  },
